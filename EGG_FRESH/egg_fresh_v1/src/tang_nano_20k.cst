//Copyright (C)2014-2025 Gowin Semiconductor Corporation.
//File Title: Physical Constraints file
//Part Number: GW2AR-LV18QN88C8/I7
//Device: GW2AR-18

// ---- Clock: PIN 4 (27MHz crystal) ----
IO_LOC "sys_clk" 4;
IO_PORT "sys_clk" PULL_MODE=UP BANK_VCCIO=3.3;

// ---- Reset S1: PIN 88, Bank 6 (VCCIO=3.3V) ----
// PULL_MODE=DOWN: thả tay=LOW(0), nhấn=HIGH(1)
// rst_n = ~rst → thả tay=rst_n=1 (FPGA chạy bình thường) ✓
IO_LOC "rst" 88;
IO_PORT "rst" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// ---- I2C: PIN 49/48, Bank 3 (VCCIO=3.3V) ----
// OPEN_DRAIN=ON bắt buộc cho I2C open-drain protocol
IO_LOC "scl" 49;
IO_PORT "scl" IO_TYPE=LVCMOS33 PULL_MODE=UP OPEN_DRAIN=ON BANK_VCCIO=3.3;
IO_LOC "sda" 48;
IO_PORT "sda" IO_TYPE=LVCMOS33 PULL_MODE=UP OPEN_DRAIN=ON BANK_VCCIO=3.3;

// ---- UART TX: PIN 69, Bank 6 (VCCIO=3.3V) ----
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---- LEDs: Bank 6 (VCCIO=3.3V), active LOW ----
IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
